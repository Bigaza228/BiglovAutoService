<Page x:Class="BiglovAutoservice.AddEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BiglovAutoservice"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddEditPage">

    <Grid Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <!-- Первая колонка сама подстроится под ширину текста -->
            <ColumnDefinition Width="Auto"/>
            <!-- Вторая колонка жестко задает хорошую ширину для полей ввода -->
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Название" FontSize="14" Grid.Column="0" Grid.Row="0" Margin="0,0,12,12" VerticalAlignment="Center"/>
        <TextBlock Text="Стоимость" FontSize="14" Grid.Column="0" Grid.Row="1" Margin="0,0,12,12" VerticalAlignment="Center"/>
        <TextBlock Text="Длительность" FontSize="14" Grid.Column="0" Grid.Row="2" Margin="0,0,12,12" VerticalAlignment="Center"/>
        <TextBlock Text="Скидка" FontSize="14" Grid.Column="0" Grid.Row="3" Margin="0,0,12,12" VerticalAlignment="Center"/>

        <TextBox Grid.Column="1" Grid.Row="0" Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center" Text="{Binding Title}"/>
        <TextBox Grid.Column="1" Grid.Row="1" Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center" Text="{Binding Cost}"/>
        <TextBox Grid.Column="1" Grid.Row="2" Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center" Text="{Binding DurationInSeconds}"/>
        <TextBox Grid.Column="1" Grid.Row="3" Height="28" Margin="0,0,0,12" VerticalContentAlignment="Center" Text="{Binding DiscountInt}"/>

        <Button Name="SaveButton" 
            Content="Сохранить" 
            Grid.Row="4" 
            Grid.Column="0" 
            Grid.ColumnSpan="2" 
            Height="30" 
            Margin="0,8,0,0"
            Click="SaveButton_Click"/>
    </Grid>
</Page>
